{
  "name": "caption-cues",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Highlight selected words in captions already shown by a page.",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config vite.site.config.ts",
    "prepare": "wxt prepare",
    "setup:browser": "node scripts/install-playwright-browser.mjs",
    "setup:browser:ci": "node scripts/install-playwright-browser.mjs --with-deps",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:claims": "npm run build && vitest run tests/claims.test.ts",
    "test:claim": "npm run build && vitest run tests/claims.test.ts -t",
    "build:extension": "wxt build",
    "package:extension": "wxt zip && node scripts/copy-extension.mjs",
    "build:site": "npm run build:extension && npm run package:extension && vite build --config vite.site.config.ts && node scripts/build-service-worker.mjs",
    "build": "npm run build:site",
    "test:pwa-update": "vitest run tests/service-worker-update.test.ts",
    "verify:extension": "node scripts/verify-extension.mjs",
    "verify:zip": "unzip -t dist/site/downloads/caption-cues-chrome.zip",
    "verify:browser": "vitest run tests/browser-qa.test.ts",
    "verify:release": "npm run check && npm run test:claims && npm run verify:extension && npm run test:pwa-update && npm run verify:browser && npm run verify:zip",
    "check:clean-browser": "node scripts/check-clean-playwright-cache.mjs",
    "check:clean-browser:ci": "node scripts/check-clean-playwright-cache.mjs --with-deps",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/chrome": "^0.0.321",
    "@types/jsdom": "^21.1.7",
    "jsdom": "^26.1.0",
    "playwright": "1.58.2",
    "sharp": "^0.35.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wxt": "^0.21.4"
  }
}
