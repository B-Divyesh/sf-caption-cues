{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [".wxt/**/*.d.ts", "entrypoints", "lib", "site", "tests", "wxt.config.ts", "vite.site.config.ts"]
}
